# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Database Settings
# For Docker / PostgreSQL: postgresql+asyncpg://riot:riotpass@localhost:5432/matchmaking
# For Local Windows testing without Docker (SQLite):
POSTGRES_URL=sqlite+aiosqlite:///./matchmaking.db

# Riot API Settings
RIOT_API_KEY=RGAPI-YOUR-API-KEY-HERE

# Matchmaking Settings
LOBBY_SIZE=2
MAX_MMR_GAP=150
MMR_EXPANSION_RATE=25
MMR_EXPANSION_INTERVAL_SEC=5
